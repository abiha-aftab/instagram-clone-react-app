# Copy to check_back/.env for local development. Never commit the real .env.
DJANGO_DEBUG=1
# Required when DJANGO_DEBUG is off. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Leave DB_NAME empty to use SQLite (check_back/db.sqlite3).
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Optional: store uploads on Cloudinary instead of check_back/media/.
CLOUDINARY_URL=

# Optional: without a broker, Celery tasks run inline.
CELERY_BROKER_URL=

# Optional: web push notifications are skipped unless a VAPID key is set.
VAPID_PRIVATE_KEY=
VAPID_ADMIN_EMAIL=admin@example.com
